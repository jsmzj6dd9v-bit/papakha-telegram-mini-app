{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "papakha-rates",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "vars": {
    "ALLOWED_ORIGINS": "https://jsmzj6dd9v-bit.github.io",
    "ENVIRONMENT": "production",
    "DEV_AUTH_ENABLED": "false",
    "INIT_DATA_MAX_AGE_SECONDS": "300",
    "MINI_APP_URL": "https://jsmzj6dd9v-bit.github.io/papakha-telegram-mini-app/",
    "ADMIN_APP_URL": "https://papakha-admin.jsmzj6dd9v.workers.dev/"
  },
  "kv_namespaces": [{
    "binding": "RATES_CACHE",
    "id": "46555e7b864f499a97b8e1f13b9f9c1f"
  }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "papakha-deals",
    "database_id": "b036b68e-afbc-48f5-8b12-a1ede2da4f12",
    "migrations_dir": "migrations"
  }],
  "queues": {
    "producers": [{ "binding": "NOTIFICATION_QUEUE", "queue": "papakha-notifications" }],
    "consumers": [{ "queue": "papakha-notifications", "max_batch_size": 10, "max_retries": 5 }]
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "env": {
    "dev": {
      "vars": {
        "ALLOWED_ORIGINS": "http://127.0.0.1:8080,http://localhost:8080",
        "ENVIRONMENT": "development",
        "DEV_AUTH_ENABLED": "true",
        "INIT_DATA_MAX_AGE_SECONDS": "300",
        "MINI_APP_URL": "http://127.0.0.1:8080/",
        "ADMIN_APP_URL": "http://127.0.0.1:8080/admin/"
      },
      "kv_namespaces": [{ "binding": "RATES_CACHE", "id": "00000000000000000000000000000000" }],
      "d1_databases": [{
        "binding": "DB",
        "database_name": "papakha-deals",
        "database_id": "00000000-0000-0000-0000-000000000000",
        "migrations_dir": "migrations"
      }],
      "queues": {
        "producers": [{ "binding": "NOTIFICATION_QUEUE", "queue": "papakha-notifications-dev" }],
        "consumers": [{ "queue": "papakha-notifications-dev", "max_batch_size": 10, "max_retries": 5 }]
      }
    }
  }
}
